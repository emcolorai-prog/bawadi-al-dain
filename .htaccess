# Settings for Apache / cPanel hosting. Other static hosts (Netlify, Vercel,
# Cloudflare Pages, GitHub Pages) ignore this file and use 404.html automatically.

# Pages and errors
DirectoryIndex index.html
ErrorDocument 404 /404.html
# If the host shows "500 Internal Server Error", delete the next line (some hosts do not allow it)
Options -Indexes

# One address for the whole site: www.bawadialdaingroup.com -> bawadialdaingroup.com
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.bawadialdaingroup\.com$ [NC]
RewriteRule ^ %{REQUEST_SCHEME}://bawadialdaingroup.com%{REQUEST_URI} [L,R=301]

# The Bawadi Al Dain General Trading website opens at the root; old /bawadi/ links go there
# (?lang= is kept). Hosts that ignore this file use the forwarding page in bawadi/index.html.
RewriteRule ^bawadi/?(index\.html)?$ / [L,R=301]

# OCEAN Engineering & Investment has its own website; old /ocean/ links go there (?lang= is kept).
# Hosts that ignore this file use the forwarding page in ocean/index.html.
RewriteRule ^ocean(/.*)?$ http://ocean-ei.com/ [L,R=301]

# Uncomment after HTTPS (SSL) is active on the domain to force secure connections
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://bawadialdaingroup.com%{REQUEST_URI} [L,R=301]

# Do not serve hidden or documentation files
<FilesMatch "^\.|\.md$">
  Require all denied
</FilesMatch>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Caching: pages always fresh, styles and scripts for a week, images for a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Basic security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
